<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon: a calendar page whose body is a clock, on teal. Adaptive,
     so the launcher gives it the same shape as other icons. Android 7 and
     older use the mipmap-*/ic_launcher.png fallbacks instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/app_teal" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
