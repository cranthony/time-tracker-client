<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for "Add note"; drag it to the home screen to
     pin it as its own icon. The launcher draws the icon and label, so they
     match the rest of the home screen. It sends the same ADD_NOTE action
     as the widget (see MainActivity). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add_note"
        android:shortcutId="add_note"
        android:shortcutLongLabel="@string/add_note_shortcut_long_label"
        android:shortcutShortLabel="@string/add_note_widget_label">
        <intent
            android:action="com.cranthony.timetracker.ADD_NOTE"
            android:targetClass="com.cranthony.timetracker.MainActivity"
            android:targetPackage="com.cranthony.timetracker" />
    </shortcut>
</shortcuts>
