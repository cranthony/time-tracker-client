<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed in release builds to reach the Time Tracker MCP server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- To set the home screen calendar's redraws again after a restart;
         see HomeWidgetScheduledUpdateReceiver below. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- To show the Google Calendar events synced to the phone on the
         Events page, if the user turns that on; see GoogleCalendarReader. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <!-- For the forecast where the phone is, if the user turns the weather
         on; roughly, a forecast needs no more. See device_location.dart. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="Time Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Intents with a URI aren't routes: Flutter's default would push
                 one for each, a second home page that fails to build. The
                 home screen widgets' taps all have one (Glance gives each a
                 URI of its own), and so does the sign-in redirect; MainActivity
                 hands each to the Dart side itself. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <!-- The "Add note" app shortcut; see res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- The sign-in redirect from WorkOS AuthKit; see MainActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.cranthony.timetracker" android:host="oauth"/>
            </intent-filter>
        </activity>
        <!-- The home screen "+" button; see AddNoteWidget. -->
        <receiver
            android:name=".AddNoteWidget"
            android:exported="false"
            android:label="@string/add_note_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_note_widget_info" />
        </receiver>
        <!-- The home screen goal button; see AddGoalWidget. -->
        <receiver
            android:name=".AddGoalWidget"
            android:exported="false"
            android:label="@string/add_goal_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_goal_widget_info" />
        </receiver>
        <!-- A home screen calendar's settings, which the launcher opens; see
             CalendarWidgetConfigureActivity. Its own task, so it doesn't
             bring the app up behind it. -->
        <activity
            android:name=".CalendarWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/calendar_widget_settings_title"
            android:theme="@style/WidgetSettingsTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- The home screen calendar; see CalendarWidget. -->
        <receiver
            android:name=".CalendarWidgetReceiver"
            android:exported="false"
            android:label="@string/calendar_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>
        <!-- A home screen goals widget's settings, as the calendar's; see
             GoalsWidgetConfigureActivity. -->
        <activity
            android:name=".GoalsWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/goals_widget_settings_title"
            android:theme="@style/WidgetSettingsTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- The home screen goals; see GoalsWidget. -->
        <receiver
            android:name=".GoalsWidgetReceiver"
            android:exported="false"
            android:label="@string/goals_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/goals_widget_info" />
        </receiver>
        <!-- Draws the calendar again as each event starts or ends, and the
             goals as each falls due, at the times the app sets
             (HomeWidget.scheduleWidgetUpdates), and sets them again after
             a restart or an update. Inexact: the app doesn't ask for exact
             alarms, so a redraw may come a few minutes late. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetScheduledUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets url_launcher open the sign-in page in a browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- And a Google Calendar event's map location in a maps app,
             and the links in its description. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
